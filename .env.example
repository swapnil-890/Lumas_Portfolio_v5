# Environment variables
# Copy this file to .env.local and fill in the values

# GitHub Personal Access Token (for commit ticker and repo stats)
# Create at: https://github.com/settings/tokens
# Required scopes: public_repo (read-only)
GITHUB_TOKEN=

# Your GitHub username
GITHUB_USERNAME=swapnil-890

# Your site URL (for SEO meta tags)
NEXT_PUBLIC_SITE_URL=https://swapnilroy.dev
